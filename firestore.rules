rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowed() {
      return request.auth != null
        && request.auth.uid in [
          'cBSmIOeTysM7hzi5Xnm7rkmsUFW2',
          'PLxEvRfAjSbj7kQumrbQ5xHF4S03'
        ];
    }

    // Per-user docs (prefs, favorites, personal shopping) — owner only.
    match /rooms/jo-and-friend/users/{userId} {
      allow read, write: if isAllowed() && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if isAllowed() && request.auth.uid == userId;
      }
    }

    // Shared room data (recipes, days, pet, games, …) — both household UIDs.
    // `users` is excluded so personal lists stay private from each other.
    match /rooms/jo-and-friend/{col}/{document=**} {
      allow read, write: if isAllowed() && col != 'users';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
